<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>お問い合わせ完了</title>
<style>
  body {
    margin: 0;
    font-family: sans-serif;
  }
  header {
    padding: 20px 30px;
  }
  .logo {
    display: inline-block;
    text-align: center;
    font-size: 18px;
    line-height: 1.3;
  }
  h1 {
    text-align: center;
    font-size: 40px;
    font-weight: normal;
    margin: 0 0 30px;
  }
  .message {
    text-align: center;
    font-size: 20px;
    line-height: 1.8;
    margin: 60px 0;
  }
  .buttons {
    display: flex;
    justify-content: center;
    margin: 40px 0;
  }
  .buttons a {
    display: block;
    width: 200px;
    padding: 12px 0;
    text-align: center;
    font-size: 18px;
    color: #000;
    text-decoration: none;
    background-color: #dae8fc;
    border: 1px solid #9eaecb;
  }
  .buttons a:hover {
    background-color: #c3d7f5;
  }
</style>
</head>
<body>
  <header>
    <div class="logo">買い物代行<br>お使い便</div>
  </header>

  <h1>お問い合わせ完了</h1>

   <p class="message">
    お問い合わせを受け付けました。<br>
    ご連絡ありがとうございました。
  </p>

  <div class="buttons">
    <a href="戻る先">トップへ戻る</a>
  </div>
